{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sales-mobile-ingest.local/contract/cloud_communication_event_package.schema.json",
  "title": "Sales Mobile Ingest Cloud Communication Event Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_contract_version", "event_id", "source_type", "recording_id", "occurred_at",
    "occurred_at_source", "occurred_at_confidence", "salesperson_id", "salesperson_name", "device_vendor",
    "device_model", "phone_number_raw", "phone_number_normalized", "phone_number_source", "phone_number_confidence",
    "contact_name", "contact_name_source", "call_direction", "call_direction_source", "duration_seconds",
    "duration_source", "media_ref", "media_sha256", "original_extension", "ingested_at", "adapter",
    "adapter_evidence_status"
  ],
  "properties": {
    "schema_version": {"const": "cloud-communication-event-package/v1"},
    "source_contract_version": {"const": "communication-event/v1"},
    "event_id": {"type": "string", "pattern": "^evt_[a-f0-9]{64}$"},
    "source_type": {"const": "phone_call"},
    "recording_id": {"type": "string", "pattern": "^rec_[a-f0-9]{64}$"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "occurred_at_source": {"enum": ["filename", "wpd_modified_at", "wpd_created_at", "import_time", "calllog_export", "unknown"]},
    "occurred_at_confidence": {"enum": ["high", "medium", "low", "unknown"]},
    "salesperson_id": {"type": "string", "minLength": 1},
    "salesperson_name": {"type": "string", "minLength": 1},
    "device_vendor": {"type": ["string", "null"]},
    "device_model": {"type": ["string", "null"]},
    "phone_number_raw": {"type": ["string", "null"]},
    "phone_number_normalized": {"type": ["string", "null"]},
    "phone_number_source": {"enum": ["filename", "wpd_metadata", "audio_metadata", "calllog_export", "manual", "unknown"]},
    "phone_number_confidence": {"enum": ["high", "medium", "low", "unknown"]},
    "contact_name": {"type": ["string", "null"]},
    "contact_name_source": {"enum": ["filename", "wpd_metadata", "audio_metadata", "calllog_export", "manual", "unknown"]},
    "call_direction": {"enum": ["incoming", "outgoing", "unknown", null]},
    "call_direction_source": {"enum": ["filename", "wpd_metadata", "calllog_export", "manual", "unknown"]},
    "duration_seconds": {"type": ["number", "integer", "null"], "minimum": 0},
    "duration_source": {"enum": ["wpd", "media_probe", "unknown"]},
    "media_ref": {"type": "string", "pattern": "^audio\\.[A-Za-z0-9]{1,10}$"},
    "media_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "original_extension": {"type": "string", "pattern": "^\\.[A-Za-z0-9]{1,10}$"},
    "ingested_at": {"type": "string", "format": "date-time"},
    "adapter": {"type": "string", "minLength": 1},
    "adapter_evidence_status": {"enum": ["REAL_DEVICE_VERIFIED", "OFFICIAL_DOC_CANDIDATE", "DOC_EVIDENCE_UNAVAILABLE", "GENERIC_HEURISTIC"]}
  }
}
